#!/bin/bash

# No set -e
# We may want to remove files before exiting
set -uo pipefail

# My compiler name
JAMC=build/src/jamc

# Underlying compiler name
# used for preprocessing and assembling
UNDER_CC=gcc

ERR=1

JAMC_FLAGS=""

# Counts times user set a flag that indicates
# stopping after a certain stage.
# More than 1 is an error.
STAGE_STOP_FLAG_COUNTER=0

# Stops compilations of multiple files
IN_FILE_COUNTER=0

IN_FILE=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        "--lex")
            JAMC_FLAGS="${JAMC_FLAGS} --lex"
            ((++STAGE_STOP_FLAG_COUNTER))
            shift
            ;;
        "--parse")
            JAMC_FLAGS="${JAMC_FLAGS} --parse"
            ((++STAGE_STOP_FLAG_COUNTER))
            shift
            ;;
        "--codegen")
            JAMC_FLAGS="${JAMC_FLAGS} --codegen"
            ((++STAGE_STOP_FLAG_COUNTER))
            shift
            ;;
        -* | --*)
            echo "Unknown flag $1"
            exit "$ERR"
            ;;
        *)
            IN_FILE="$1"
            ((++IN_FILE_COUNTER))
            shift
            ;;
    esac
done

# Fails if:
#     - Not exactly one input file
#     - Too many stage stop flags
#     - Non-existent file
if [ "$IN_FILE_COUNTER" -ne 1 ]\
    || [ "$STAGE_STOP_FLAG_COUNTER" -gt 1 ]\
    || [ ! -f "$IN_FILE" ]; then
    echo "Usage: ./jamc [--lex | --parse | --codegen] INPUT_FILE"
    exit "$ERR"
fi

IN_FILE_NO_EXT="${IN_FILE%.*}"
IN_FILE_E="${IN_FILE_NO_EXT}.i"
IN_FILE_S="${IN_FILE_NO_EXT}.s"
OUT_FILE="$IN_FILE_NO_EXT"

# -P ensures no linemarkers emission
"$UNDER_CC" -E -P "$IN_FILE" -o "$IN_FILE_E"
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
    exit "$STATUS"
fi

# Use our compiler here
"$JAMC" $JAMC_FLAGS "$IN_FILE_E"
STATUS=$?
rm "$IN_FILE_E"
if [ "$STATUS" -ne 0 ]; then
    exit "$STATUS"
fi

"$UNDER_CC" "$IN_FILE_S" -o "$OUT_FILE"
STATUS=$?
rm "$IN_FILE_S"
if [ "$STATUS" -ne 0 ]; then
    exit "$STATUS"
fi
